{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mccboard",
  "identifier": "io.github.nunziati.mccboard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "instances",
        "title": "mccboard",
        "width": 960,
        "height": 600,
        "minWidth": 640,
        "minHeight": 360,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Control center for several Claude Code accounts",
    "longDescription": "A control center for running several Claude Code accounts side by side: it sets them up, keeps them consistent, and shows how much of each account's usage is left.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
